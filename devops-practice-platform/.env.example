# ---- Database ----
POSTGRES_USER=devops
POSTGRES_PASSWORD=devops
POSTGRES_DB=devops_platform
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Full connection string (used by the API; overrides the parts above if set)
DATABASE_URL=postgres://devops:devops@localhost:5432/devops_platform

# Set to true for managed providers that require TLS (e.g. Azure Database for
# PostgreSQL). Also auto-enabled when DATABASE_URL contains sslmode=require.
DATABASE_SSL=false

# ---- API server ----
PORT=4000
# Comma-separated list of allowed CORS origins for the web client
CORS_ORIGIN=http://localhost:5173

# ---- Web client (Vite) ----
# Base URL the React app uses to reach the API
VITE_API_BASE_URL=http://localhost:4000/api
